{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@dietrichgebert/ponytail"],
  "model": "azure/gpt-5.6-sol",
  "autoupdate": true,
  "provider": {
    "azure": {
      "options": {
        "apiKey": "",
        "baseURL": "https://<resourceName>.services.ai.azure.com/openai",
        "resourceName": "<resourceName>"
      },
      "models": {
        "gpt-5.4": {
          "name": "gpt-5.4",
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "high",
            "reasoningSummary": "auto"
          }
        },
        "gpt-5.5": {
          "name": "gpt-5.5",
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "high",
            "reasoningSummary": "auto"
          }
        },
        "gpt-5.6-sol": {
          "name": "gpt-5.6-sol",
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "high",
            "reasoningSummary": "auto"
          }
        },
        "gpt-6-astra": {
          "name": "gpt-6-astra",
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "high",
            "reasoningSummary": "auto"
          }
        }	
      }
    },
    "azure-cognitive-services": {
      "options": {
        "apiKey": "",
        "baseURL": "https://<resourceName>.cognitiveservices.azure.com/openai",
        "resourceName": "<resourceName>"
      },
      "models": {
        "gpt-5.4": {
          "name": "gpt-5.4",
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "high",
            "reasoningSummary": "auto"
          }
        },
        "gpt-5.5": {
          "name": "gpt-5.5",
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "high",
            "reasoningSummary": "auto"
          }
        },
        "gpt-5.6-sol": {
          "name": "gpt-5.6-sol",
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "high",
            "reasoningSummary": "auto"
          }
        },
        "gpt-6-astra": {
          "name": "gpt-6-astra",
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "high",
            "reasoningSummary": "auto"
          }
        }	
      }
    },
    "google": {
      "options": {
        "apiKey": ""
      },
      "models": {
        "gemini-2.5-flash": {
          "options": {
            "thinkingConfig": {
              "thinkingBudget": 8192,
              "includeThoughts": false
            }
          }
        },
        "gemini-3.1-flash-lite-preview": {
          "options": {
            "thinkingConfig": {
              "includeThoughts": false
            }
          }
        }
      }
    }
  },
  "mcp": {
    "nushell": {
      "type": "local",
      "enabled": true,
      "command": [
        "<home dir>/.cargo/bin/nu",
        "--no-history",
        "--mcp"
      ],
      "environment": {
        "HOME": "<home dir>",
        "PATH": "<home dir>/.cargo/bin:/usr/local/bin:/usr/bin:/bin",
        "MCP_NU_MCP_TIMEOUT": "600"
      },
    }
  }
}
