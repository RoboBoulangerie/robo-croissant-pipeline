      "@type": "sc:Dataset",
      "name": "CADRE (Children's Allergy and Asthma Data Repository)",
      "alternateName": "Children's Allergy and Asthma Data Repository",
      "description": "The Children’s Allergy and Asthma Data Repository (CADRE) is a centralized resource created to address a critical gap in asthma research: identifying the risk factors and biological mechanisms that lead to childhood asthma. By uniting data from various cohorts, CADRE empowers researchers to uncover insights that individual studies alone cannot provide.",
      "url": "https://cadre.med.wisc.edu/",
      "conformsTo": "http://mlcommons.org/croissant/1.0",
      "keywords": "asthma research, childhood asthma, allergy, birth cohort studies, data repository, biological mechanisms, risk factors",
